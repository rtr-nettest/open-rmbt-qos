<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>at.rtr.rmbt</groupId>
    <artifactId>RMBTQoSServer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>RMBTQoSServer</name>
    <description>RMBT QoS test server (extracted from open-rmbt)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Source/target Java 17; compiles & runs on JDK 17 through 25 -->
        <maven.compiler.release>17</maven.compiler.release>
        <main.class>at.rtr.rmbt.qos.testserver.TestServer</main.class>

        <!-- restlet kept on 2.4.x: 2.5-M1 / 3.0-M1 are pre-release milestones -->
        <restlet.version>2.4.4</restlet.version>
        <!-- slf4j kept on 2.0.x: 2.1.0-alpha1 is a pre-release -->
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.5</logback.version>
        <logstash.encoder.version>9.0</logstash.encoder.version>
        <jackson.version>3.2.4</jackson.version>
        <json.version>20260814</json.version>
        <gson.version>2.14.0</gson.version>
        <guava.version>33.7.2-jre</guava.version>
        <dnsjava.version>3.6.5</dnsjava.version>
        <junit.version>6.1.3</junit.version>
        <mockito.version>5.24.0</mockito.version>
    </properties>

    <repositories>
        <repository>
            <id>maven-restlet</id>
            <name>Restlet repository</name>
            <url>https://maven.restlet.talend.com</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson 3 comes in transitively via logstash-logback-encoder (9.0 pulls 3.0.1, which has
                 known vulnerabilities); pin the whole Jackson family to a current release. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST framework -->
        <dependency>
            <groupId>org.restlet.jse</groupId>
            <artifactId>org.restlet</artifactId>
            <version>${restlet.version}</version>
        </dependency>

        <!-- Logging: SLF4J + Logback (+ Logstash encoder), mirroring the ControlServer -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Guava (Helperfunctions / qos util) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <!-- DNS lookups (Helperfunctions) -->
        <dependency>
            <groupId>dnsjava</groupId>
            <artifactId>dnsjava</artifactId>
            <version>${dnsjava.version}</version>
        </dependency>

        <!-- Tests: JUnit 5 + Mockito -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>RMBTQoSServer</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!-- Version from git (same schema as open-rmbt-client-cli): written to version.properties -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>git-version</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <!-- Full describe with commit hash, e.g. "v2.0.0-4-ged32b3d" (just "v2.0.0" on the tag) -->
                                <exec executable="git"
                                      outputproperty="git.describe.full"
                                      resultproperty="git.result.full"
                                      failonerror="false"
                                      dir="${project.basedir}">
                                    <arg value="describe"/>
                                    <arg value="--tags"/>
                                    <arg value="--always"/>
                                </exec>
                                <!-- Current branch, e.g. "dev" — suffixed onto the revision string -->
                                <exec executable="git"
                                      outputproperty="git.branch"
                                      resultproperty="git.branch.result"
                                      failonerror="false"
                                      dir="${project.basedir}">
                                    <arg value="rev-parse"/>
                                    <arg value="--abbrev-ref"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <condition property="git.version.full"
                                           value="${git.describe.full}"
                                           else="dev">
                                    <equals arg1="${git.result.full}" arg2="0"/>
                                </condition>
                                <!-- Full describe suffixed with branch, e.g. "v2.0.0-4-ged32b3d-dev";
                                     if the branch is unknown, no suffix is added. -->
                                <condition property="git.revision"
                                           value="${git.version.full}-${git.branch}"
                                           else="${git.version.full}">
                                    <and>
                                        <equals arg1="${git.branch.result}" arg2="0"/>
                                        <length string="${git.branch}" trim="true" when="greater" length="0"/>
                                    </and>
                                </condition>
                                <mkdir dir="${project.build.outputDirectory}"/>
                                <echo file="${project.build.outputDirectory}/version.properties"
                                      message="version.full=${git.version.full}${line.separator}version.revision=${git.revision}${line.separator}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exposes ${org.mockito:mockito-core:jar} (the resolved jar path) for the surefire agent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- Load Mockito as a Java agent (inline mock maker) instead of self-attaching,
                         which is required on current/future JDKs (17 through 25). -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <!-- Runnable fat jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
